<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup / device-transfer rules for API 31+ (android:dataExtractionRules).
    Backups are disabled via android:allowBackup="false"; these rules keep the
    widget API key out of cloud backups and device-to-device transfers should
    allowBackup ever be re-enabled.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="habitikami_widget_secure.xml" />
        <exclude domain="sharedpref" path="habitikami_widget.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="habitikami_widget_secure.xml" />
        <exclude domain="sharedpref" path="habitikami_widget.xml" />
    </device-transfer>
</data-extraction-rules>
