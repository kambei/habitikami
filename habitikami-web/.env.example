VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_SPREADSHEET_ID=
# Server-only OAuth client secret (never prefixed with VITE_: Vite would expose it to the browser).
# VITE_GOOGLE_CLIENT_SECRET is still read as a deprecated fallback.
GOOGLE_CLIENT_SECRET=

# Private mode: comma-separated Google accounts allowed to sign in and use widgets.
# Leave empty for open access.
ALLOWED_EMAILS=

# Web push reminders (optional). Leave empty: the server generates the VAPID
# keys once into data/vapid.json. Set PUSH_SCHEDULER=off to disable the
# minute scheduler (e.g. on a second replica).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_SCHEDULER=

# Shared AI key (optional): lets the assistant work without a personal key,
# SERVER_AI_DAILY_QUOTA calls a day per account (default 20).
SERVER_AI_PROVIDER=
SERVER_AI_KEY=
SERVER_AI_DAILY_QUOTA=20
