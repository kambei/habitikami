VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_SPREADSHEET_ID=
# Server-only OAuth client secret (never prefixed with VITE_: Vite would expose it to the browser).
# VITE_GOOGLE_CLIENT_SECRET is still read as a deprecated fallback.
GOOGLE_CLIENT_SECRET=

# Private mode: comma-separated Google accounts allowed to sign in and use widgets.
# Leave empty for open access.
ALLOWED_EMAILS=
