{
  "name": "Habitikami",
  "short_name": "Habitikami",
  "description": "Build better habits, track your progress, and level up your daily routine.",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "background_color": "#0a0a0f",
  "theme_color": "#7c3aed",
  "orientation": "any",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "protocol_handlers": [
    {
      "protocol": "web+habitikami",
      "url": "/?url=%s"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-1024x500.png",
      "sizes": "1024x500",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile.png",
      "sizes": "768x1713",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile View"
    },
    {
      "src": "/screenshots/desktop.png",
      "sizes": "768x1713",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop View"
    }
  ],
  "widgets": [
    {
      "name": "Habitikami Summary",
      "short_name": "Habits",
      "description": "Today's progress, streak and next habit, with quick actions.",
      "tag": "habit-summary",
      "template": "/widgets/habit-summary.json",
      "ms_ac_template": "/widgets/habit-summary.json",
      "data": "/widgets/data/habit-summary-data.json",
      "type": "application/json",
      "icons": [
        {
          "src": "/icons/icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "screenshots": [
        {
          "src": "/screenshots/widgets/widget-summary.png",
          "sizes": "600x524",
          "type": "image/png",
          "label": "Habitikami Summary"
        }
      ],
      "update": 900
    },
    {
      "name": "Habitikami Counters",
      "short_name": "Counters",
      "description": "Today's counters (resisted, smoked, coffee…) at a glance.",
      "tag": "counters-today",
      "template": "/widgets/counters-today.json",
      "ms_ac_template": "/widgets/counters-today.json",
      "data": "/widgets/data/habit-summary-data.json",
      "type": "application/json",
      "icons": [
        {
          "src": "/icons/icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "screenshots": [
        {
          "src": "/screenshots/widgets/widget-counters.png",
          "sizes": "600x428",
          "type": "image/png",
          "label": "Habitikami Counters"
        }
      ],
      "update": 900
    },
    {
      "name": "Habitikami Streak",
      "short_name": "Streak",
      "description": "Your longest current streak and the habit behind it.",
      "tag": "streak",
      "template": "/widgets/streak.json",
      "ms_ac_template": "/widgets/streak.json",
      "data": "/widgets/data/habit-summary-data.json",
      "type": "application/json",
      "icons": [
        {
          "src": "/icons/icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "screenshots": [
        {
          "src": "/screenshots/widgets/widget-streak.png",
          "sizes": "600x472",
          "type": "image/png",
          "label": "Habitikami Streak"
        }
      ],
      "update": 900
    }
  ],
  "lang": "en",
  "dir": "ltr"
}