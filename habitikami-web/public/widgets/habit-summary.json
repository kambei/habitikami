{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            { "type": "TextBlock", "text": "🏯", "size": "ExtraLarge" }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "Habitikami", "size": "Medium", "weight": "Bolder", "color": "Accent", "wrap": true },
            { "type": "TextBlock", "text": "${date}", "size": "Small", "isSubtle": true, "spacing": "None" }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Large",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "${labels.completed}", "size": "Small", "isSubtle": true, "horizontalAlignment": "Center" },
            { "type": "TextBlock", "text": "${completedCount} / ${totalCount}", "size": "Large", "weight": "Bolder", "color": "Good", "spacing": "None", "horizontalAlignment": "Center" }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "${labels.streak}", "size": "Small", "isSubtle": true, "horizontalAlignment": "Center" },
            { "type": "TextBlock", "text": "${currentStreak} ${labels.days}", "size": "Large", "weight": "Bolder", "color": "Warning", "spacing": "None", "horizontalAlignment": "Center" }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Medium",
      "separator": true,
      "items": [
        { "type": "TextBlock", "text": "${labels.nextUp}", "size": "Small", "isSubtle": true, "horizontalAlignment": "Center" },
        { "type": "TextBlock", "text": "${nextHabitName}", "size": "Medium", "weight": "Bolder", "spacing": "None", "horizontalAlignment": "Center", "wrap": true }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${labels.updated} ${updatedAt}",
      "size": "Small",
      "isSubtle": true,
      "horizontalAlignment": "Right",
      "spacing": "Small"
    }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "${labels.completeNext}", "verb": "complete-next", "style": "positive" },
    { "type": "Action.Execute", "title": "${labels.skipNext}", "verb": "skip-next" },
    { "type": "Action.Execute", "title": "${labels.openApp}", "verb": "open-app" }
  ]
}
